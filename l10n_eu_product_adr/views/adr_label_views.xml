<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="adr_label_view_form" model="ir.ui.view">
        <field name="model">adr.label</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="image" widget="image" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="adr_label_kanban_form" model="ir.ui.view">
        <field name="model">adr.label</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id" />
                <templates>
                    <t t-name="card" class="p-0">
                        <div
                            t-attf-class="oe_kanban_global_click d-flex align-items-center gap-3 p-2 overflow-hidden"
                        >
                            <div
                                class="o_kanban_image flex-shrink-0 d-flex align-items-center justify-content-center"
                            >
                                <field
                                    name="image"
                                    t-if="record.image.raw_value"
                                    widget="image"
                                    options="{'preview_image': 'image', 'img_class': 'o_image_64_contain mw-100'}"
                                    alt="Label"
                                />
                            </div>
                            <div
                                class="oe_kanban_details flex-grow-1 min-w-0 text-wrap text-break overflow-hidden"
                            >
                                <p class="mb-1">
                                    <strong>
                                        <field name="code" />
                                    </strong>
                                </p>
                                <p class="mb-0">
                                    <field name="name" />
                                </p>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="adr_label_view_search" model="ir.ui.view">
        <field name="model">adr.label</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
            </search>
        </field>
    </record>
    <record id="adr_label_action" model="ir.actions.act_window">
        <field name="name">Dangerous Goods Labels</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">adr.label</field>
        <field name="view_mode">kanban,form</field>
    </record>
</odoo>
