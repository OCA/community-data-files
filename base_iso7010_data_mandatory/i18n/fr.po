#. module: base_iso7010_data_mandatory
#: model:iso7010.symbol,description:base_iso7010_data_mandatory.iso7010_symbol_m026
msgid "Indicates that a protective apron must be worn."
msgstr "Indique qu'un tablier de protection doit être porté."


#. module: base_iso7010_data_mandatory
