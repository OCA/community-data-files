#. module: base_iso7010_data_mandatory
#: model:iso7010.symbol,name:base_iso7010_data_mandatory.iso7010_symbol_m001
msgid "General mandatory action sign"
msgstr "Obligation générale"

#. module: base_iso7010_data_mandatory
#: model:iso7010.symbol,description:base_iso7010_data_mandatory.iso7010_symbol_m001
msgid "Indicates that a mandatory action (unspecified) is required."
msgstr "Indique qu'une action obligatoire (non spécifiée) est requise."

#. module: base_iso7010_data_mandatory
#: model:iso7010.symbol,name:base_iso7010_data_mandatory.iso7010_symbol_m002
