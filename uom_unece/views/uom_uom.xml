<odoo>
    <record id="uom_uom_view_form" model="ir.ui.view">
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_form" />
        <field name="arch" type="xml">
            <group name="uom_details" position="inside">
                <field name="unece_code" />
            </group>
        </field>
    </record>
    <record id="uom_uom_view_list" model="ir.ui.view">
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_list" />
        <field name="arch" type="xml">
            <list position="inside">
                <field name="unece_code" optional="show" />
            </list>
        </field>
    </record>
    <record id="uom_uom_view_search" model="ir.ui.view">
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_search" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="unece_code" />
            </field>
        </field>
    </record>
</odoo>
