<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sanitary_registry_tree" model="ir.ui.view">
        <field name="name">sanitary.registry tree</field>
        <field name="model">sanitary.registry</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="action_sanitary_registry" model="ir.actions.act_window">
        <field name="name">Sanitary Registries</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sanitary.registry</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem
        action="action_sanitary_registry"
        id="menu_action_sanitary_registry"
        parent="base.menu_users"
        sequence="100"
    />
</odoo>
